# Local development environment for Cloud Agents.
# These are non-secret defaults for the in-VM Postgres + local Neon HTTP proxy.
# Real deployments should use Neon connection strings and real secrets instead.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/timesheet
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:5432/timesheet
NEON_LOCAL_FETCH_ENDPOINT=http://127.0.0.1:4444/sql
NEON_PROXY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/timesheet
JIRA_WEBHOOK_SECRET=dev-webhook-secret
INTERNAL_PM_BASE_URL=https://bitmap.app
SETTINGS_ENCRYPTION_KEY=dev-local-encryption-key-change-me
ALLOW_PUBLIC_REGISTER=true
LOG_LEVEL=debug
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
